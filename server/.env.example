# Copie para server/.env e ajuste. NUNCA versione o arquivo .env com segredos reais.
# Ambientes: development | staging (homologação) | production
APP_ENV=development
HOST=127.0.0.1
PORT=3000
# URL pública (links de convite, recuperação de senha e webhooks). Em homologação/produção: https obrigatório.
APP_URL=http://localhost:5173

# Papel sujeito a RLS (sem BYPASSRLS) — usado em todas as operações de usuário.
DATABASE_URL=postgres://venceu_app:TROQUE_ESTA_SENHA@127.0.0.1:5432/venceu_dev
# Papel proprietário — autenticação, automações, webhooks, migrações e scripts.
DATABASE_OWNER_URL=postgres://venceu_owner:TROQUE_ESTA_SENHA@127.0.0.1:5432/venceu_dev
DATABASE_SSL=false
# Certificado (PEM) da autoridade do banco — obrigatório para TLS verificado no Supabase.
DATABASE_SSL_CA=
# Conexões por instância (serverless: 1–2).
DB_POOL_MAX=15

# Chave mestra (32 bytes em base64): cifra tokens do WhatsApp e assina links.
# OBRIGATÓRIA em homologação/produção. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar a chave invalida os tokens já salvos (será preciso informá-los de novo).
SECRETS_KEY=

# memory (uma instância) ou postgres (serverless / várias instâncias)
RATE_LIMIT_STORE=memory

# Somente se o frontend for servido de outra origem (separar por vírgula).
CORS_ORIGINS=
# true quando atrás de proxy reverso/balanceador confiável (IP real para limites de tentativas).
TRUST_PROXY=false

# E-mail: SMTP_USER + SMTP_PASSWORD (ex.: Gmail com senha de app) ou SMTP_URL.
# Sem SMTP em homologação/produção, defina MAIL_MODE=manual (convites por link; lembretes só por WhatsApp).
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_URL=
MAIL_MODE=
MAIL_FROM=Venceu <nao-responda@seu-dominio.com.br>

SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
# Build do frontend servido pelo backend (homologação/produção).
WEB_DIST_DIR=../web/dist
LOG_LEVEL=info
